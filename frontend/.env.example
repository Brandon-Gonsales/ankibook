# Firebase web app config (Firebase console > Project settings > Your apps > Web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_APP_ID=""

# Backend base URL. In dev the Vite proxy forwards /api to localhost:8000.
VITE_API_URL="/api/v1"

# Optional, development only: skip Firebase and send X-User-Id to the backend
# (works only while the backend runs with ENVIRONMENT=development).
VITE_DEV_UID=""
