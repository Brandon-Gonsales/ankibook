# Application Settings
PROJECT_NAME="AnkiBook Backend API"
VERSION="0.1.0"
DESCRIPTION="API REST de AnkiBook desarrollada con FastAPI y SQLModel"
API_V1_PREFIX="/api/v1"
# "development" enables the X-User-Id login shortcut: use it ONLY locally.
# On the VPS set ENVIRONMENT="production" and ANKIBOOK_DEBUG=false.
ENVIRONMENT="development"
ANKIBOOK_DEBUG=true

# Database Connection (direct async URL)
DATABASE_URL="postgresql://ankibook_user:[YOUR-PASSWORD]@localhost:5432/ankibook"

# Study day: "Repasar" adds at most this many never-seen cards per user and
# day ("Estudiar libro/lección" is not limited). The day starts at
# SRS_DAY_START_HOUR in SRS_TIMEZONE.
SRS_NEW_CARDS_PER_DAY=20
SRS_TIMEZONE="America/La_Paz"
SRS_DAY_START_HOUR=4

# Firebase Admin (never commit the JSON credentials file)
# Official Google ADC name; FIREBASE_CREDENTIALS_PATH is also accepted.
GOOGLE_APPLICATION_CREDENTIALS="C:/secure/path/firebase-service-account.json"
FIREBASE_PROJECT_ID="your-firebase-project-id"
